{
  "name": "astro-blog-theme",
  "version": "0.2.10",
  "type": "module",
  "description": "A reusable Astro blog theme, importable straight from GitHub like a Hugo module.",
  "author": "Erik Skopp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eskopp/AstroBlogTheme.git"
  },
  "keywords": ["astro", "astro-integration", "astro-theme", "blog", "theme"],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./content": "./src/content.ts",
    "./i18n": "./src/i18n.ts",
    "./posts": "./src/posts.ts",
    "./tags": "./src/tags.ts",
    "./styles.css": "./src/styles/global.css",
    "./components/*": "./src/components/*",
    "./layouts/*": "./src/layouts/*",
    "./routes/*": "./src/routes/*",
    "./virtual.d.ts": "./src/virtual.d.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "astro": "^5.0.0"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.4.1"
  }
}
