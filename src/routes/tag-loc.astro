---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getAllPosts, postLocale } from "../posts";
import { tagSlug } from "../tags";
import { defaultLocale, locales, localeHref, t } from "../i18n";

export async function getStaticPaths() {
  const all = await getAllPosts();
  const paths = [];
  for (const locale of locales) {
    if (locale === defaultLocale) continue;
    const posts = all.filter((p) => postLocale(p.id) === locale);
    const groups = new Map<string, { name: string; posts: typeof posts }>();
    for (const post of posts) {
      for (const name of post.data.tags) {
        const slug = tagSlug(name);
        if (!groups.has(slug)) groups.set(slug, { name, posts: [] });
        groups.get(slug)!.posts.push(post);
      }
    }
    for (const [slug, g] of groups) {
      paths.push({
        params: { locale, tag: slug },
        props: { locale, tagName: g.name, posts: g.posts },
      });
    }
  }
  return paths;
}

const { locale, tagName, posts } = Astro.props;
---

<BaseLayout
  locale={locale}
  title={`#${tagName}`}
  description={t("postsTagged", locale, { tag: tagName })}
>
  <p class="tag-page__back">
    <a href={localeHref(locale, "/tags")}>← {t("allTags", locale)}</a>
  </p>
  <h1>#{tagName}</h1>
  <ul class="post-list">
    {posts.map((post) => <li><PostCard post={post} /></li>)}
  </ul>
</BaseLayout>
