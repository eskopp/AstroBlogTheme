---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getPosts } from "../posts";
import { tagSlug } from "../tags";
import { defaultLocale, localeHref, t } from "../i18n";

export async function getStaticPaths() {
  const posts = await getPosts(defaultLocale);
  const groups = new Map<string, { name: string; posts: typeof posts }>();
  for (const post of posts) {
    for (const name of post.data.tags) {
      const slug = tagSlug(name);
      if (!groups.has(slug)) groups.set(slug, { name, posts: [] });
      groups.get(slug)!.posts.push(post);
    }
  }
  return [...groups.entries()].map(([slug, g]) => ({
    params: { tag: slug },
    props: { tagName: g.name, posts: g.posts },
  }));
}

const { tagName, posts } = Astro.props;
const locale = defaultLocale;
---

<BaseLayout
  locale={locale}
  title={`#${tagName}`}
  description={t("postsTagged", locale, { tag: tagName })}
>
  <p class="tag-page__back">
    <a href={localeHref(locale, "/tags")}>← {t("allTags", locale)}</a>
  </p>
  <h1>#{tagName}</h1>
  <ul class="post-list">
    {posts.map((post) => <li><PostCard post={post} /></li>)}
  </ul>
</BaseLayout>
