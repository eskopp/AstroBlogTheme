---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getTags } from "../tags";
import { localeFromPath, localeHref, t } from "../i18n";

const locale = localeFromPath(Astro.url.pathname);
const tags = await getTags(locale);
---

<BaseLayout locale={locale} title={t("tags", locale)}>
  <h1>{t("tags", locale)}</h1>
  {
    tags.length === 0 ? (
      <p>{t("noTags", locale)}</p>
    ) : (
      <ul class="tag-cloud">
        {tags.map((tag) => (
          <li>
            <a href={localeHref(locale, `/tags/${tag.slug}/`)}>
              {tag.name} <span class="tag-cloud__count">{tag.count}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
