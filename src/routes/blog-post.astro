---
import { render } from "astro:content";
import PostLayout from "../layouts/PostLayout.astro";
import { getAllPosts } from "../posts";
import { postLocale, postSlug } from "../i18n";

export async function getStaticPaths() {
  const all = await getAllPosts();
  const byLocale = new Map<string, typeof all>();
  for (const post of all) {
    const loc = postLocale(post.id);
    if (!byLocale.has(loc)) byLocale.set(loc, []);
    byLocale.get(loc)!.push(post);
  }

  const paths = [];
  for (const posts of byLocale.values()) {
    posts.forEach((post, i) => {
      paths.push({
        params: { slug: postSlug(post) },
        props: { post, next: posts[i - 1], prev: posts[i + 1] },
      });
    });
  }
  return paths;
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout post={post} prev={prev} next={next} headings={headings}>
  <Content />
</PostLayout>
