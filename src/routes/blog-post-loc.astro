---
import { render } from "astro:content";
import PostLayout from "../layouts/PostLayout.astro";
import { getAllPosts } from "../posts";
import { postLocale, postSlug, defaultLocale, locales } from "../i18n";

export async function getStaticPaths() {
  const all = await getAllPosts();
  const paths = [];
  for (const locale of locales) {
    if (locale === defaultLocale) continue;
    const posts = all.filter((p) => postLocale(p.id) === locale);
    posts.forEach((post, index) => {
      paths.push({
        params: { locale, slug: postSlug(post.id) },
        props: { post, next: posts[index - 1], prev: posts[index + 1] },
      });
    });
  }
  return paths;
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---

<PostLayout post={post} prev={prev} next={next}>
  <Content />
</PostLayout>
