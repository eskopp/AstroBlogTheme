---
import config from "virtual:astro-blog-theme/config";
import { defaultLocale, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  alternates: { locale: Locale; href: string }[];
}
const { locale, alternates } = Astro.props;

const label = (loc: Locale) => config.localeLabels?.[loc] ?? loc.toUpperCase();

/** Where the switcher sends you for a locale when this page has no translation. */
const home = (loc: Locale) =>
  config.localeHome?.[loc] ?? (loc === defaultLocale ? "/" : `/${loc}/`);

const hrefFor = (loc: Locale) =>
  alternates.find((a) => a.locale === loc)?.href ?? home(loc);
---

<div class="lang-switch" role="group" aria-label="Language">
  {
    config.locales.map((loc: Locale, i: number) => (
      <>
        {i > 0 && <span class="lang-switch__sep" aria-hidden="true">/</span>}
        {loc === locale ? (
          <span class="lang-switch__current" aria-current="true">{label(loc)}</span>
        ) : (
          <a href={hrefFor(loc)}>{label(loc)}</a>
        )}
      </>
    ))
  }
</div>
