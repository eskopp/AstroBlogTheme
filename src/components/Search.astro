---
---

<div class="search" data-search>
  <button
    type="button"
    class="search__toggle"
    aria-label="Search"
    aria-expanded="false"
    aria-controls="search-panel"
    data-search-toggle
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="M21 21l-4.3-4.3"></path>
    </svg>
  </button>

  <div class="search__panel" id="search-panel" hidden data-search-panel>
    <input
      type="search"
      class="search__input"
      placeholder="Search posts…"
      aria-label="Search posts"
      autocomplete="off"
      spellcheck="false"
      data-search-input
    />
    <ul class="search__results" data-search-results></ul>
    <p class="search__empty" hidden data-search-empty>No matching posts.</p>
  </div>
</div>

<script>
  const root = document.querySelector("[data-search]");
  if (root) {
    const toggle = root.querySelector<HTMLButtonElement>("[data-search-toggle]")!;
    const panel = root.querySelector<HTMLElement>("[data-search-panel]")!;
    const input = root.querySelector<HTMLInputElement>("[data-search-input]")!;
    const list = root.querySelector<HTMLElement>("[data-search-results]")!;
    const empty = root.querySelector<HTMLElement>("[data-search-empty]")!;

    type Entry = {
      title: string;
      description: string;
      tags: string[];
      date: string;
      url: string;
      body: string;
    };

    let entries: Entry[] | null = null;
    let loading: Promise<void> | null = null;

    const load = () => {
      if (!loading) {
        loading = fetch("/search.json")
          .then((r) => r.json())
          .then((data: Entry[]) => {
            entries = data;
          })
          .catch(() => {
            entries = [];
          });
      }
      return loading;
    };

    const score = (e: Entry, q: string): number => {
      const t = e.title.toLowerCase();
      if (t === q) return 100;
      if (t.startsWith(q)) return 80;
      if (t.includes(q)) return 60;
      if (e.tags.some((tag) => tag.toLowerCase().includes(q))) return 40;
      if (e.description.toLowerCase().includes(q)) return 30;
      if (e.body.toLowerCase().includes(q)) return 10;
      return 0;
    };

    const render = () => {
      const q = input.value.trim().toLowerCase();
      list.innerHTML = "";
      if (!q || !entries) {
        empty.hidden = true;
        return;
      }
      const hits = entries
        .map((e) => ({ e, s: score(e, q) }))
        .filter((x) => x.s > 0)
        .sort((a, b) => b.s - a.s || +new Date(b.e.date) - +new Date(a.e.date))
        .slice(0, 8);

      empty.hidden = hits.length > 0;
      for (const { e } of hits) {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = e.url;
        a.innerHTML = `<span class="search__result-title"></span><span class="search__result-desc"></span>`;
        a.querySelector(".search__result-title")!.textContent = e.title;
        a.querySelector(".search__result-desc")!.textContent = e.description;
        li.appendChild(a);
        list.appendChild(li);
      }
    };

    const open = () => {
      panel.hidden = false;
      toggle.setAttribute("aria-expanded", "true");
      void load().then(render);
      input.focus();
    };
    const close = () => {
      panel.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
      input.value = "";
      list.innerHTML = "";
      empty.hidden = true;
    };

    toggle.addEventListener("click", () =>
      panel.hidden ? open() : close(),
    );
    input.addEventListener("input", () => {
      load().then(render);
    });
    document.addEventListener("keydown", (ev) => {
      if (ev.key === "Escape" && !panel.hidden) close();
      if (ev.key === "/" && panel.hidden && document.activeElement === document.body) {
        ev.preventDefault();
        open();
      }
    });
    document.addEventListener("click", (ev) => {
      if (!panel.hidden && !root.contains(ev.target as Node)) close();
    });
  }
</script>
