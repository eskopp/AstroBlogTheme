---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { defaultLocale, t, type Locale } from "../i18n";

interface Props {
  /** An imported image (`import pic from "./pic.jpg"`) for build-time
   *  optimisation, or a string path for something in `public/`. */
  src: ImageMetadata | string;
  alt: string;
  /** Caption shown below the image. Plain text. */
  caption?: string;
  /** Rights holder / source, e.g. "© 2026 Erik Skopp" or "Photo: NASA/JPL".
   *  Required — the build warns if it is missing. */
  credit: string;
  /** Optional link for the credit (photographer page, license, source). */
  creditHref?: string;
  /** Whether the image was generated with AI. Required — pass `true` or
   *  `false` for every image. `true` shows an "AI" badge. */
  ai: boolean;
  /** Locale for the badge tooltip. Defaults to the site's default locale. */
  locale?: Locale;
  /** Passed through to <Image> for imported sources. */
  widths?: number[];
  sizes?: string;
  loading?: "lazy" | "eager";
  /** Widen the figure past the prose column ("bleed") or keep it inline. */
  wide?: boolean;
}

const {
  src,
  alt,
  caption,
  credit,
  creditHref,
  ai,
  locale = defaultLocale,
  widths = [480, 768, 1200, 1600],
  sizes = "(min-width: 45rem) 42rem, 100vw",
  loading = "lazy",
  wide = false,
} = Astro.props;

const isImported = typeof src !== "string";

if (import.meta.env.PROD) {
  if (!credit)
    console.warn(`[astro-blog-theme] <Figure> is missing "credit" (alt: "${alt}")`);
  if (typeof ai !== "boolean")
    console.warn(`[astro-blog-theme] <Figure> is missing "ai" (alt: "${alt}")`);
}
---

<figure class:list={["prose-figure", { "prose-figure--wide": wide }]}>
  {
    isImported ? (
      <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} />
    ) : (
      <img src={src} alt={alt} loading={loading} />
    )
  }
  {
    (caption || credit || ai) && (
      <figcaption>
        {caption && <span class="figure__caption">{caption}</span>}
        <span class="figure__meta">
          {credit &&
            (creditHref ? (
              <a href={creditHref}>{credit}</a>
            ) : (
              <span>{credit}</span>
            ))}
          {ai && (
            <span class="ai-flag ai-flag--fig" title={t("imageAi", locale)}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 3l2 5 5 2-5 2-2 5-2-5-5-2 5-2z" />
              </svg>
              AI
            </span>
          )}
        </span>
      </figcaption>
    )
  }
</figure>
