---
import type { Post } from "../posts";
import { getSeriesContexts } from "../series";
import { postSlug, t, type Locale } from "../i18n";

interface Props {
  post: Post;
  locale: Locale;
}

const { post, locale } = Astro.props;
const contexts = await getSeriesContexts(post);
---

{
  contexts.map((s) => (
    <details class="series-nav">
      <summary class="series-nav__bar">
        <span class="series-nav__kicker">
          {t("seriesPart", locale, { n: s.index, total: s.total })}
        </span>
        <span class="series-nav__sep">·</span>
        <span class="series-nav__name">{s.title}</span>
      </summary>
      <ol class="series-nav__list" start="1">
        {s.parts.map((part) =>
          part.id === post.id ? (
            <li aria-current="true">{part.data.title}</li>
          ) : (
            <li>
              <a href={`/blog/${postSlug(part)}/`}>{part.data.title}</a>
            </li>
          ),
        )}
      </ol>
      <a class="series-nav__more" href={`/series/${s.slug}/`}>
        {t("seriesOverview", locale)} →
      </a>
    </details>
  ))
}
