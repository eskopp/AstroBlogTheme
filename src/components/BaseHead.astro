---
import config from "virtual:astro-blog-theme/config";
import { defaultLocale, localeHref, type Locale } from "../i18n";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  locale?: Locale;
  alternates?: { locale: Locale; href: string }[];
}

const {
  title,
  description = config.description,
  image = "/og-default.svg",
  article = false,
  locale = defaultLocale,
  alternates = [],
} = Astro.props;

const base = Astro.site ?? Astro.url;
const pageTitle = title ? `${title} · ${config.title}` : config.title;
const canonical = new URL(Astro.url.pathname, base);
const socialImage = new URL(image, base);
const ogLocale = config.localeMeta?.[locale] ?? config.locale;
const rssHref = new URL(localeHref(locale, "/rss.xml"), base);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonical} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={config.title}
  href={rssHref}
/>
{
  alternates.map((alt) => (
    <link
      rel="alternate"
      hreflang={alt.locale}
      href={new URL(alt.href, base)}
    />
  ))
}
{
  alternates.length > 0 && (
    <link rel="alternate" hreflang="x-default" href={canonical} />
  )
}

<title>{pageTitle}</title>
<meta name="description" content={description} />
{config.author && <meta name="author" content={config.author} />}
<meta name="generator" content={Astro.generator} />

<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:site_name" content={config.title} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:locale" content={ogLocale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<script is:inline>
  const root = document.documentElement;
  const stored = (() => {
    try {
      return localStorage.getItem("theme");
    } catch (e) {
      return null;
    }
  })();
  root.dataset.theme =
    stored === "light" || stored === "dark"
      ? stored
      : window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
</script>
