---
import config from "virtual:astro-blog-theme/config";
import { defaultLocale, type Locale } from "../i18n";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  locale?: Locale;
  alternates?: { locale: Locale; href: string }[];
  noindex?: boolean;
  /** Set on article pages for BlogPosting structured data. */
  articleMeta?: { published: string; modified?: string };
}

const {
  title,
  description = config.description,
  image = "/og-default.svg",
  article = false,
  locale = defaultLocale,
  alternates = [],
  noindex = false,
  articleMeta,
} = Astro.props;

const base = Astro.site ?? Astro.url;
const pageTitle = title ? `${title} · ${config.title}` : config.title;
const canonical = new URL(Astro.url.pathname, base);
const socialImage = new URL(image, base);
const ogLocale = config.localeMeta?.[locale] ?? config.locale;

const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: config.title,
    url: new URL("/", base).href,
    description: config.description,
  },
];
if (article && articleMeta) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title ?? config.title,
    description,
    url: canonical.href,
    image: socialImage.href,
    datePublished: articleMeta.published,
    dateModified: articleMeta.modified ?? articleMeta.published,
    inLanguage: locale,
    ...(config.author
      ? { author: { "@type": "Person", name: config.author } }
      : {}),
  });
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonical} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={config.title}
  href={new URL("/rss.xml", base)}
/>
{
  config.locales.length > 1 &&
    config.locales
      .filter((loc: Locale) => loc !== defaultLocale)
      .map((loc: Locale) => (
        <link
          rel="alternate"
          type="application/rss+xml"
          hreflang={loc}
          title={`${config.title} (${config.localeLabels?.[loc] ?? loc.toUpperCase()})`}
          href={new URL(`/rss/${loc}.xml`, base)}
        />
      ))
}
<link
  rel="alternate"
  type="application/feed+json"
  title={config.title}
  href={new URL("/feed.json", base)}
/>
{
  alternates.map((alt) => (
    <link rel="alternate" hreflang={alt.locale} href={new URL(alt.href, base)} />
  ))
}
{
  alternates.length > 0 && (
    <link rel="alternate" hreflang="x-default" href={canonical} />
  )
}

<title>{pageTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{config.author && <meta name="author" content={config.author} />}
<meta name="generator" content={Astro.generator} />

<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:site_name" content={config.title} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:locale" content={ogLocale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

{jsonLd.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry)} />)}

<script is:inline define:vars={{ colorScheme: config.colorScheme }}>
  const root = document.documentElement;
  const stored = (() => {
    try {
      return localStorage.getItem("theme");
    } catch (e) {
      return null;
    }
  })();
  let theme = stored === "light" || stored === "dark" ? stored : null;
  if (!theme) {
    theme =
      colorScheme === "light" || colorScheme === "dark"
        ? colorScheme
        : window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
  }
  root.dataset.theme = theme;
</script>
