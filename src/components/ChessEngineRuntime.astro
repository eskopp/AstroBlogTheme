---
---

<script>
  import { renderChessBoard, xyToSquare, squareToXY, pieceMarkup } from "../chess.mjs";

  interface MoveNode {
    id: number;
    san: string;
    fen: string;
    lastMove: { from: string; to: string };
    parent: MoveNode | null;
    /** children[0] is the mainline continuation; children[1+] are side variations. */
    children: MoveNode[];
  }

  interface Ctx {
    board: HTMLElement;
    engineNode: HTMLElement | null;
    controlsNode: HTMLElement | null;
    orientation: "white" | "black";
    initialFen: string;
    startColor: "w" | "b";
    startFullmove: number;
    fen: string;
    lastMove: { from: string; to: string } | null;
    chess: any;
    root: MoveNode;
    currentNode: MoveNode;
    nodesById: Map<number, MoveNode>;
    /** Tap-to-move: the square lifted by a first tap, awaiting a destination tap. */
    selected: string | null;
  }

  let nextNodeId = 1;
  const SQ = 45;
  const BOARD = SQ * 8;

  const boards = [...document.querySelectorAll<HTMLElement>(".chess-board")];
  if (
    boards.length > 0 &&
    typeof Worker !== "undefined" &&
    typeof WebAssembly !== "undefined"
  ) {
    let worker: Worker | null = null;
    let ChessCtor: any = null;
    // Only one infinite search runs at a time; starting another stops this one first.
    let active: { ctx: Ctx; stop: () => Promise<void> } | null = null;

    const multiThreaded =
      typeof SharedArrayBuffer !== "undefined" &&
      (self as any).crossOriginIsolated === true;

    async function ensureEngine(): Promise<Worker> {
      if (worker) return worker;
      const w = new Worker(
        multiThreaded ? "/stockfish/engine-mt.js" : "/stockfish/engine.js",
      );
      await new Promise<void>((resolve, reject) => {
        const onMessage = (e: MessageEvent) => {
          if (typeof e.data === "string" && e.data.includes("uciok")) {
            w.removeEventListener("message", onMessage);
            resolve();
          }
        };
        w.addEventListener("message", onMessage);
        w.addEventListener("error", () => reject(new Error("worker error")), {
          once: true,
        });
        w.postMessage("uci");
      });
      if (multiThreaded) {
        const threads = Math.max(
          1,
          Math.min((navigator.hardwareConcurrency || 4) - 1, 16),
        );
        w.postMessage(`setoption name Threads value ${threads}`);
      }
      w.postMessage("setoption name Hash value 128");
      w.postMessage("setoption name MultiPV value 3");
      worker = w;
      return w;
    }

    async function ensureChess() {
      if (!ChessCtor) {
        const mod = await import("chess.js");
        ChessCtor = mod.Chess;
      }
      return ChessCtor;
    }
    // Kick off eagerly: dragging needs move validation before the engine ever loads.
    ensureChess();

    const MAX_PLIES = 8;

    /** UCI moves (e.g. "e2e4") -> a short SAN line, e.g. "1. e4 e5 2. Nf3". */
    function formatLine(
      fen: string,
      uciMoves: string[],
      Chess: any,
      maxPlies = MAX_PLIES,
    ): string {
      const chess = new Chess(fen);
      const parts: string[] = [];
      let moveNo = parseInt(fen.split(/\s+/)[5] || "1", 10) || 1;
      if (chess.turn() === "b") parts.push(`${moveNo}...`);
      for (let i = 0; i < uciMoves.length && i < maxPlies; i++) {
        const uci = uciMoves[i];
        const whiteToMove = chess.turn() === "w";
        let move: any = null;
        try {
          move = chess.move({
            from: uci.slice(0, 2),
            to: uci.slice(2, 4),
            promotion: uci.slice(4) || undefined,
          });
        } catch {
          break;
        }
        if (!move) break;
        if (whiteToMove) {
          parts.push(`${moveNo}.`, move.san);
        } else {
          parts.push(move.san);
          moveNo++;
        }
      }
      return parts.join(" ");
    }

    function renderBoard(ctx: Ctx) {
      ctx.selected = null;
      const old = ctx.board.querySelector(".chess-board__frame");
      if (!old) return;
      old.outerHTML = renderChessBoard(ctx.fen, {
        orientation: ctx.orientation,
        lastMove: ctx.lastMove,
      });
      attachPieceHandlers(ctx);
    }

    function sideToMove(fen: string): "w" | "b" {
      return fen.split(/\s+/)[1] === "b" ? "b" : "w";
    }

    function renderSelection(ctx: Ctx) {
      const svg = ctx.board.querySelector<SVGSVGElement>(
        ".chess-board__frame svg",
      );
      if (!svg) return;
      svg.querySelectorAll(".chess-board__selected").forEach((el) => el.remove());
      if (!ctx.selected) return;
      const { x, y } = squareToXY(ctx.selected, ctx.orientation);
      const rect = document.createElementNS(svg.namespaceURI, "rect");
      rect.setAttribute("class", "chess-board__selected");
      rect.setAttribute("x", String(x));
      rect.setAttribute("y", String(y));
      rect.setAttribute("width", String(SQ));
      rect.setAttribute("height", String(SQ));
      rect.setAttribute("fill", "var(--chess-selected, rgba(60, 140, 255, .45))");
      const firstPiece = svg.querySelector("use[data-square]");
      if (firstPiece) svg.insertBefore(rect, firstPiece);
      else svg.appendChild(rect);
    }

    function selectSquare(ctx: Ctx, square: string) {
      ctx.selected = square;
      renderSelection(ctx);
    }

    function clearSelection(ctx: Ctx) {
      ctx.selected = null;
      renderSelection(ctx);
    }

    function escHtml(s: string) {
      return s.replace(/&/g, "&amp;").replace(/</g, "&lt;");
    }

    const STANDARD_START =
      "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";

    /** The mainline path from the root down to (and including) `node`. */
    function pathToNode(node: MoveNode): MoveNode[] {
      const path: MoveNode[] = [];
      let n: MoveNode | null = node;
      while (n && n.parent) {
        path.unshift(n);
        n = n.parent;
      }
      return path;
    }

    /** SAN move text for the path to the current node, e.g. "1. e4 e5 2. Nf3". */
    function buildMoveText(ctx: Ctx): string {
      const path = pathToNode(ctx.currentNode);
      let out = "";
      let moveNo = ctx.startFullmove;
      let turn = ctx.startColor;
      if (turn === "b" && path.length > 0) out += `${moveNo}... `;
      for (const node of path) {
        if (turn === "w") out += `${moveNo}. `;
        out += node.san + " ";
        if (turn === "b") moveNo++;
        turn = turn === "w" ? "b" : "w";
      }
      return out.trim();
    }

    /** Open in Lichess as a game (PGN + moves), not just a static FEN. */
    function buildLichessUrl(ctx: Ctx): string {
      const moves = buildMoveText(ctx);
      const pgn =
        ctx.initialFen.trim() === STANDARD_START
          ? moves
          : `[FEN "${ctx.initialFen.trim()}"]\n[SetUp "1"]\n\n${moves}`;
      return `https://lichess.org/analysis/pgn/${encodeURIComponent(pgn)}`;
    }

    /** Once moves exist, point "Open in Lichess" at the full game instead of a bare FEN. */
    function updateLichessLink(ctx: Ctx) {
      if (ctx.currentNode === ctx.root) return;
      const link = ctx.board.querySelector<HTMLAnchorElement>(
        ".chess-board__lichess",
      );
      if (link) link.href = buildLichessUrl(ctx);
    }

    /** PGN if moves have been played, otherwise the bare position as FEN. */
    function buildCopyText(ctx: Ctx): string {
      if (ctx.currentNode === ctx.root) return ctx.initialFen.trim();
      const moves = buildMoveText(ctx);
      return ctx.initialFen.trim() === STANDARD_START
        ? moves
        : `[FEN "${ctx.initialFen.trim()}"]\n[SetUp "1"]\n\n${moves}`;
    }

    function renderCheckHighlight(ctx: Ctx) {
      const svg = ctx.board.querySelector<SVGSVGElement>(
        ".chess-board__frame svg",
      );
      if (!svg) return;
      svg.querySelectorAll(".chess-board__check").forEach((el) => el.remove());
      if (!ctx.chess || !ctx.chess.isCheck()) return;
      const kingSquare = ctx.chess.findPiece({
        type: "k",
        color: ctx.chess.turn(),
      })[0];
      if (!kingSquare) return;
      const { x, y } = squareToXY(kingSquare, ctx.orientation);
      const rect = document.createElementNS(svg.namespaceURI, "rect");
      rect.setAttribute("class", "chess-board__check");
      rect.setAttribute("x", String(x));
      rect.setAttribute("y", String(y));
      rect.setAttribute("width", String(SQ));
      rect.setAttribute("height", String(SQ));
      rect.setAttribute("fill", "var(--chess-check, rgba(220, 38, 38, .55))");
      const firstPiece = svg.querySelector("use[data-square]");
      if (firstPiece) svg.insertBefore(rect, firstPiece);
      else svg.appendChild(rect);
    }

    function updateStatus(ctx: Ctx) {
      renderCheckHighlight(ctx);
      const statusEl = ctx.controlsNode?.querySelector<HTMLElement>(
        ".chess-controls__status",
      );
      if (!statusEl) return;
      const d = statusEl.dataset;
      let text = "";
      if (ctx.chess) {
        if (ctx.chess.isCheckmate()) {
          text =
            (ctx.chess.turn() === "w" ? d.checkmateBlack : d.checkmateWhite) ?? "";
        } else if (ctx.chess.isStalemate()) {
          text = d.stalemate ?? "";
        } else if (ctx.chess.isDraw()) {
          text = d.draw ?? "";
        } else if (ctx.chess.isCheck()) {
          text = d.check ?? "";
        }
      }
      statusEl.textContent = text;
      statusEl.hidden = !text;
    }

    function refreshBoardUI(ctx: Ctx) {
      renderBoard(ctx);
      renderMoveList(ctx);
      updateLichessLink(ctx);
      updateStatus(ctx);
    }

    /**
     * Record a played move from the current node. If it already exists among
     * the current node's children (a move already explored from here), reuse
     * that branch instead of duplicating it. A move that diverges from the
     * existing mainline child becomes a new side variation, not a discard.
     */
    function addMove(ctx: Ctx, move: any) {
      const fen = ctx.chess.fen();
      let node = ctx.currentNode.children.find(
        (c) => c.san === move.san && c.fen === fen,
      );
      if (!node) {
        node = {
          id: nextNodeId++,
          san: move.san,
          fen,
          lastMove: { from: move.from, to: move.to },
          parent: ctx.currentNode,
          children: [],
        };
        ctx.currentNode.children.push(node);
        ctx.nodesById.set(node.id, node);
      }
      ctx.currentNode = node;
      ctx.fen = node.fen;
      ctx.lastMove = node.lastMove;
    }

    function renderMoveSpan(ctx: Ctx, node: MoveNode): string {
      const active = node === ctx.currentNode ? " is-active" : "";
      return `<span class="chess-moves__move${active}" data-id="${node.id}">${escHtml(node.san)}</span>`;
    }

    /**
     * Recursively renders the mainline from `node` onward, plus any side
     * variations inline as "(...)" groups right where they branch off -
     * standard PGN/Lichess style.
     */
    function renderLine(
      ctx: Ctx,
      node: MoveNode,
      moveNo: number,
      turn: "w" | "b",
      forceNumber: boolean,
    ): string {
      let html = "";
      let cur = node;
      let needsNumber = forceNumber;
      while (cur.children.length > 0) {
        const mainChild = cur.children[0];
        if (turn === "w") {
          html += `<span class="chess-moves__no">${moveNo}.</span> `;
        } else if (needsNumber) {
          html += `<span class="chess-moves__no">${moveNo}...</span> `;
        }
        html += renderMoveSpan(ctx, mainChild) + " ";
        needsNumber = false;

        for (let i = 1; i < cur.children.length; i++) {
          const varNode = cur.children[i];
          const nextMoveNo = turn === "w" ? moveNo : moveNo + 1;
          const nextTurn = turn === "w" ? "b" : "w";
          html += `<span class="chess-moves__variation">(`;
          html +=
            turn === "w"
              ? `<span class="chess-moves__no">${moveNo}.</span> `
              : `<span class="chess-moves__no">${moveNo}...</span> `;
          html += renderMoveSpan(ctx, varNode) + " ";
          html += renderLine(ctx, varNode, nextMoveNo, nextTurn, true);
          html += `)</span> `;
          needsNumber = true;
        }

        if (turn === "b") moveNo++;
        turn = turn === "w" ? "b" : "w";
        cur = mainChild;
      }
      return html;
    }

    function renderMoveList(ctx: Ctx) {
      const container = ctx.controlsNode?.querySelector<HTMLElement>(
        ".chess-controls__moves",
      );
      const resetBtn = ctx.controlsNode?.querySelector<HTMLButtonElement>(
        ".chess-controls__reset",
      );
      if (resetBtn) {
        resetBtn.disabled =
          ctx.currentNode === ctx.root && ctx.root.children.length === 0;
      }
      if (!container) return;

      const forceNumber = ctx.startColor === "b" && ctx.root.children.length > 0;
      container.innerHTML = renderLine(
        ctx,
        ctx.root,
        ctx.startFullmove,
        ctx.startColor,
        forceNumber,
      );
      container.querySelectorAll<HTMLElement>("[data-id]").forEach((el) => {
        const id = parseInt(el.dataset.id || "", 10);
        el.addEventListener("click", () => {
          const node = ctx.nodesById.get(id);
          if (node) gotoNode(ctx, node);
        });
      });
    }

    async function gotoNode(ctx: Ctx, node: MoveNode) {
      if (active?.ctx === ctx) await active.stop();
      const Chess = await ensureChess();
      ctx.currentNode = node;
      ctx.fen = node.fen;
      ctx.chess = new Chess(node.fen);
      ctx.lastMove = node === ctx.root ? null : node.lastMove;
      refreshBoardUI(ctx);
    }

    function svgPoint(svg: SVGSVGElement, evt: PointerEvent) {
      const pt = svg.createSVGPoint();
      pt.x = evt.clientX;
      pt.y = evt.clientY;
      const ctm = svg.getScreenCTM();
      if (!ctm) return null;
      const loc = pt.matrixTransform(ctm.inverse());
      return { x: loc.x, y: loc.y };
    }

    function ensurePieceSymbol(svg: SVGSVGElement, piece: string) {
      let defs = svg.querySelector("defs");
      if (!defs) {
        defs = document.createElementNS(svg.namespaceURI, "defs");
        svg.prepend(defs);
      }
      if (svg.querySelector(`#p-${piece}`)) return;
      const symbol = document.createElementNS(svg.namespaceURI, "symbol");
      symbol.setAttribute("id", `p-${piece}`);
      symbol.setAttribute("viewBox", "0 0 45 45");
      symbol.innerHTML = pieceMarkup(piece);
      defs.appendChild(symbol);
    }

    /** Shows a 4-piece picker over the promotion square; resolves the chosen type, or null if cancelled. */
    function askPromotion(
      ctx: Ctx,
      square: string,
      color: "w" | "b",
    ): Promise<"q" | "r" | "b" | "n" | null> {
      return new Promise((resolve) => {
        const svg = ctx.board.querySelector<SVGSVGElement>(
          ".chess-board__frame svg",
        );
        if (!svg) {
          resolve("q");
          return;
        }
        const { x, y } = squareToXY(square, ctx.orientation);
        const stackDown = y < BOARD / 2;
        const choices: Array<"q" | "n" | "r" | "b"> = ["q", "n", "r", "b"];
        const group = document.createElementNS(svg.namespaceURI, "g");
        group.setAttribute("class", "chess-board__promotion");

        function finish(choice: "q" | "r" | "b" | "n" | null) {
          group.remove();
          resolve(choice);
        }

        const backdrop = document.createElementNS(svg.namespaceURI, "rect");
        backdrop.setAttribute("x", "0");
        backdrop.setAttribute("y", "0");
        backdrop.setAttribute("width", String(BOARD));
        backdrop.setAttribute("height", String(BOARD));
        backdrop.setAttribute("fill", "rgba(0, 0, 0, .35)");
        backdrop.addEventListener("pointerdown", (e) => {
          e.stopPropagation();
          finish(null);
        });
        group.appendChild(backdrop);

        choices.forEach((type, i) => {
          const cellY = stackDown ? y + i * SQ : y - i * SQ;
          const pieceCode = color + type.toUpperCase();
          ensurePieceSymbol(svg, pieceCode);

          const cellBg = document.createElementNS(svg.namespaceURI, "rect");
          cellBg.setAttribute("x", String(x));
          cellBg.setAttribute("y", String(cellY));
          cellBg.setAttribute("width", String(SQ));
          cellBg.setAttribute("height", String(SQ));
          cellBg.setAttribute("fill", "var(--surface, #fff)");
          cellBg.setAttribute("stroke", "var(--border-strong, #333)");
          cellBg.addEventListener("pointerdown", (e) => {
            e.stopPropagation();
            finish(type);
          });

          const use = document.createElementNS(svg.namespaceURI, "use");
          use.setAttribute("href", `#p-${pieceCode}`);
          use.setAttribute("x", String(x));
          use.setAttribute("y", String(cellY));
          use.setAttribute("width", String(SQ));
          use.setAttribute("height", String(SQ));

          group.appendChild(cellBg);
          group.appendChild(use);
        });

        svg.appendChild(group);
      });
    }

    async function handleMove(ctx: Ctx, from: string, to: string | null) {
      if (!to || to === from) {
        renderBoard(ctx);
        return;
      }
      const Chess = await ensureChess();
      if (!ctx.chess) ctx.chess = new Chess(ctx.fen);

      const piece = ctx.chess.get(from);
      let promotion: "q" | "r" | "b" | "n" = "q";
      if (piece && piece.type === "p" && (to[1] === "8" || to[1] === "1")) {
        const color = ctx.chess.turn();
        const choice = await askPromotion(ctx, to, color);
        if (!choice) {
          renderBoard(ctx);
          return;
        }
        promotion = choice;
      }

      let move: any = null;
      try {
        move = ctx.chess.move({ from, to, promotion });
      } catch {
        // illegal move — chess.js throws rather than returning null
      }
      if (!move) {
        renderBoard(ctx);
        return;
      }
      addMove(ctx, move);
      refreshBoardUI(ctx);

      if (active?.ctx === ctx) {
        await active.stop();
        start(ctx);
      }
    }

    // Below this distance (SVG units, board is 360x360) a press+release counts
    // as a tap (lift/place) rather than a drag - needed for touch, where a
    // dragged piece sits under the finger and hides the target square.
    const DRAG_THRESHOLD = 10;

    function onSquarePointerDown(
      e: PointerEvent,
      ctx: Ctx,
      svg: SVGSVGElement,
      square: string,
      pieceEl: SVGUseElement | null,
    ) {
      if (e.button !== 0) return;
      e.preventDefault();
      const pendingSelection = ctx.selected;
      const start0 = svgPoint(svg, e);
      if (!start0) return;
      let dragging = false;
      let baseX = 0;
      let baseY = 0;
      let dx = 0;
      let dy = 0;
      if (pieceEl) {
        baseX = parseFloat(pieceEl.getAttribute("x") || "0");
        baseY = parseFloat(pieceEl.getAttribute("y") || "0");
        dx = start0.x - baseX;
        dy = start0.y - baseY;
      }

      function onMove(ev: PointerEvent) {
        const p = svgPoint(svg, ev);
        if (!p) return;
        if (!dragging && pieceEl) {
          const moved = Math.hypot(p.x - start0!.x, p.y - start0!.y);
          if (moved > DRAG_THRESHOLD) {
            dragging = true;
            if (ctx.selected) clearSelection(ctx);
            svg.appendChild(pieceEl);
            pieceEl.classList.add("is-dragging");
          }
        }
        if (dragging && pieceEl) {
          pieceEl.setAttribute("x", String(p.x - dx));
          pieceEl.setAttribute("y", String(p.y - dy));
        }
      }

      function onUp(ev: PointerEvent) {
        window.removeEventListener("pointermove", onMove);
        window.removeEventListener("pointerup", onUp);

        if (dragging && pieceEl) {
          const p = svgPoint(svg, ev);
          const half = 22.5;
          const toSquare = p
            ? xyToSquare(p.x - dx + half, p.y - dy + half, ctx.orientation)
            : null;
          handleMove(ctx, square, toSquare);
          return;
        }

        // A tap, not a drag.
        if (pendingSelection && pendingSelection === square) {
          clearSelection(ctx);
        } else if (pendingSelection) {
          const ownPieceOfSideToMove =
            pieceEl && pieceEl.dataset.piece?.[0] === sideToMove(ctx.fen);
          clearSelection(ctx);
          if (ownPieceOfSideToMove) {
            selectSquare(ctx, square);
          } else {
            handleMove(ctx, pendingSelection, square);
          }
        } else if (pieceEl && pieceEl.dataset.piece?.[0] === sideToMove(ctx.fen)) {
          selectSquare(ctx, square);
        }
      }

      window.addEventListener("pointermove", onMove);
      window.addEventListener("pointerup", onUp, { once: true });
    }

    function attachPieceHandlers(ctx: Ctx) {
      const svg = ctx.board.querySelector<SVGSVGElement>(
        ".chess-board__frame svg",
      );
      if (!svg) return;
      for (const rect of svg.querySelectorAll<SVGRectElement>(
        "rect[data-square]",
      )) {
        const square = rect.dataset.square!;
        rect.addEventListener("pointerdown", (e) =>
          onSquarePointerDown(e, ctx, svg, square, null),
        );
      }
      for (const piece of svg.querySelectorAll<SVGUseElement>(
        "use[data-square]",
      )) {
        const square = piece.dataset.square!;
        piece.addEventListener("pointerdown", (e) =>
          onSquarePointerDown(e, ctx, svg, square, piece),
        );
      }
    }

    async function applyLineToBoard(ctx: Ctx, uciMoves: string[]) {
      if (active?.ctx === ctx) await active.stop();
      const Chess = await ensureChess();
      // Engine analysis only runs on the current position, so ctx.chess already
      // reflects the line's base position (nothing else can mutate it meanwhile).
      if (!ctx.chess) ctx.chess = new Chess(ctx.fen);
      for (let i = 0; i < uciMoves.length && i < MAX_PLIES; i++) {
        const uci = uciMoves[i];
        let move: any = null;
        try {
          move = ctx.chess.move({
            from: uci.slice(0, 2),
            to: uci.slice(2, 4),
            promotion: uci.slice(4) || undefined,
          });
        } catch {
          break;
        }
        if (!move) break;
        addMove(ctx, move);
      }
      refreshBoardUI(ctx);
    }

    function renderLines(
      output: HTMLElement,
      lines: Map<number, { text: string; moves: string[] }>,
      ctx: Ctx,
    ) {
      const sorted = [...lines.entries()].sort((a, b) => a[0] - b[0]);
      output.innerHTML =
        `<p class="chess-engine__credit">` +
        `<a href="https://stockfishchess.org/" target="_blank" rel="noopener">Stockfish</a> · GPLv3</p>` +
        sorted
          .map(([, v]) => `<div class="chess-engine__line">${v.text}</div>`)
          .join("");
      output.hidden = false;
      output
        .querySelectorAll<HTMLElement>(".chess-engine__line")
        .forEach((el, i) => {
          el.addEventListener("click", () =>
            applyLineToBoard(ctx, sorted[i][1].moves),
          );
        });
      renderArrows(ctx, sorted);
    }

    const ARROW_COLORS = ["#1a9850", "#4575b4", "#8a8f98"];

    function ensureArrowMarker(svg: SVGSVGElement, id: string, color: string) {
      let defs = svg.querySelector("defs");
      if (!defs) {
        defs = document.createElementNS(svg.namespaceURI, "defs");
        svg.prepend(defs);
      }
      if (svg.querySelector(`#${id}`)) return;
      const marker = document.createElementNS(svg.namespaceURI, "marker");
      marker.setAttribute("id", id);
      marker.setAttribute("viewBox", "0 0 10 10");
      marker.setAttribute("refX", "8");
      marker.setAttribute("refY", "5");
      marker.setAttribute("markerWidth", "5");
      marker.setAttribute("markerHeight", "5");
      marker.setAttribute("orient", "auto-start-reverse");
      const path = document.createElementNS(svg.namespaceURI, "path");
      path.setAttribute("d", "M0,0 L10,5 L0,10 z");
      path.setAttribute("fill", color);
      marker.appendChild(path);
      defs.appendChild(marker);
    }

    /** Draws the top engine lines' first move as arrows, best (index 0) on top. */
    function renderArrows(
      ctx: Ctx,
      sorted: [number, { text: string; moves: string[] }][],
    ) {
      const svg = ctx.board.querySelector<SVGSVGElement>(
        ".chess-board__frame svg",
      );
      if (!svg) return;
      svg.querySelectorAll(".chess-board__arrow").forEach((el) => el.remove());

      for (let i = sorted.length - 1; i >= 0; i--) {
        const uci = sorted[i][1].moves[0];
        if (!uci) continue;
        const from = squareToXY(uci.slice(0, 2), ctx.orientation);
        const to = squareToXY(uci.slice(2, 4), ctx.orientation);
        const x1 = from.x + SQ / 2;
        const y1 = from.y + SQ / 2;
        const dx = to.x - from.x;
        const dy = to.y - from.y;
        const len = Math.hypot(dx, dy) || 1;
        // shorten so the arrowhead lands before the square's centre
        const x2 = from.x + SQ / 2 + (dx / len) * (len - SQ * 0.35);
        const y2 = from.y + SQ / 2 + (dy / len) * (len - SQ * 0.35);
        const color = ARROW_COLORS[i] ?? ARROW_COLORS[ARROW_COLORS.length - 1];
        const markerId = `chess-arrow-head-${i}`;
        ensureArrowMarker(svg, markerId, color);

        const line = document.createElementNS(svg.namespaceURI, "line");
        line.setAttribute("class", "chess-board__arrow");
        line.setAttribute("x1", String(x1));
        line.setAttribute("y1", String(y1));
        line.setAttribute("x2", String(x2));
        line.setAttribute("y2", String(y2));
        line.setAttribute("stroke", color);
        line.setAttribute("stroke-width", "6");
        line.setAttribute("stroke-linecap", "round");
        line.setAttribute("opacity", i === 0 ? "0.85" : "0.55");
        line.setAttribute("marker-end", `url(#${markerId})`);
        svg.appendChild(line);
      }
    }

    async function start(ctx: Ctx) {
      if (active) await active.stop();

      const toggle = ctx.engineNode?.querySelector<HTMLButtonElement>(
        ".chess-engine__toggle",
      );
      const output = ctx.engineNode?.querySelector<HTMLElement>(
        ".chess-engine__lines",
      );
      if (!toggle || !output) return;
      const d = toggle.dataset;

      toggle.disabled = true;
      toggle.textContent = d.labelLoading ?? "…";
      output.hidden = true;
      output.innerHTML = "";

      try {
        const [engine, Chess] = await Promise.all([ensureEngine(), ensureChess()]);
        const searchFen = ctx.fen;
        const activeColor = searchFen.split(/\s+/)[1] === "b" ? "b" : "w";
        const lines = new Map<number, { text: string; moves: string[] }>();

        const done = new Promise<void>((resolve) => {
          const onMessage = (e: MessageEvent) => {
            const line = typeof e.data === "string" ? e.data : "";
            if (line.startsWith("info") && line.includes(" pv ")) {
              const mpv = /multipv (\d+)/.exec(line);
              const cp = /score cp (-?\d+)/.exec(line);
              const mate = /score mate (-?\d+)/.exec(line);
              const pv = /\bpv (.+)$/.exec(line);
              if (mpv && pv) {
                let evalStr = "";
                if (mate) {
                  const n = parseInt(mate[1], 10) * (activeColor === "b" ? -1 : 1);
                  evalStr = `#${n}`;
                } else if (cp) {
                  const val = parseInt(cp[1], 10) * (activeColor === "b" ? -1 : 1);
                  evalStr = (val > 0 ? "+" : "") + (val / 100).toFixed(2);
                }
                const moves = pv[1].trim().split(/\s+/);
                const san = formatLine(searchFen, moves, Chess);
                lines.set(parseInt(mpv[1], 10), { text: `${evalStr}  ${san}`, moves });
                renderLines(output, lines, ctx);
              }
            } else if (line.startsWith("bestmove")) {
              engine.removeEventListener("message", onMessage);
              resolve();
            }
          };
          engine.addEventListener("message", onMessage);
          engine.postMessage(`position fen ${searchFen}`);
          engine.postMessage("go infinite");
        });

        toggle.textContent = d.labelStop ?? "Stop";
        toggle.disabled = false;
        active = {
          ctx,
          stop: async () => {
            toggle.disabled = true;
            toggle.textContent = d.labelStopping ?? "…";
            engine.postMessage("stop");
            await done;
          },
        };

        await done;
        active = null;
        toggle.textContent = d.labelReanalyze ?? d.labelLoad ?? "";
        toggle.disabled = false;
      } catch (err) {
        console.error("stockfish analysis failed:", err);
        active = null;
        toggle.textContent = d.labelError ?? "Error";
        toggle.disabled = false;
      }
    }

    for (const board of boards) {
      const engineNode = board.querySelector<HTMLElement>(".chess-engine");
      const controlsNode = board.querySelector<HTMLElement>(".chess-controls");
      if (engineNode) engineNode.hidden = false;
      if (controlsNode) controlsNode.hidden = false;

      const initialFen = board.dataset.fen || "";
      const startFields = initialFen.split(/\s+/);
      const root: MoveNode = {
        id: nextNodeId++,
        san: "",
        fen: initialFen,
        lastMove: { from: "", to: "" },
        parent: null,
        children: [],
      };
      const ctx: Ctx = {
        board,
        engineNode,
        controlsNode,
        orientation: board.dataset.orientation === "black" ? "black" : "white",
        initialFen,
        startColor: startFields[1] === "b" ? "b" : "w",
        startFullmove: parseInt(startFields[5] || "1", 10) || 1,
        fen: initialFen,
        lastMove: null,
        chess: null,
        root,
        currentNode: root,
        nodesById: new Map([[root.id, root]]),
        selected: null,
      };
      attachPieceHandlers(ctx);
      engineNode
        ?.querySelector<HTMLButtonElement>(".chess-engine__toggle")
        ?.addEventListener("click", () => {
          if (active?.ctx === ctx) {
            active.stop();
          } else {
            start(ctx);
          }
        });
      controlsNode
        ?.querySelector<HTMLButtonElement>(".chess-controls__reset")
        ?.addEventListener("click", () => gotoNode(ctx, ctx.root));
      controlsNode
        ?.querySelector<HTMLButtonElement>(".chess-controls__copy")
        ?.addEventListener("click", (e) => {
          const button = e.currentTarget as HTMLButtonElement;
          const text = buildCopyText(ctx);
          navigator.clipboard?.writeText(text).then(() => {
            const d = button.dataset;
            button.textContent = d.labelCopied ?? "Copied!";
            setTimeout(() => {
              button.textContent = d.labelCopy ?? "Copy";
            }, 1500);
          }).catch((err) => console.error("copy failed:", err));
        });
      // Detect check/mate on the initial diagram too, not just after a move.
      ensureChess().then((Chess) => {
        if (!ctx.chess) {
          ctx.chess = new Chess(ctx.fen);
          updateStatus(ctx);
        }
      });
    }
  }
</script>
