---
import { defaultLocale, t, type Locale } from "../i18n";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  locale?: Locale;
}
const { headings, locale = defaultLocale } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length >= 3 && (
    <nav class="toc" aria-label={t("tableOfContents", locale)}>
      <p class="toc__title">{t("tableOfContents", locale)}</p>
      <ol>
        {items.map((h) => (
          <li class:list={[`toc__d${h.depth}`]}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
