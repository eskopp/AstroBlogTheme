---
import config from "virtual:astro-blog-theme/config";
import ThemeToggle from "./ThemeToggle.astro";
import Search from "./Search.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { defaultLocale, localeHref, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
  alternates?: { locale: Locale; href: string }[];
}
const { locale = defaultLocale, alternates = [] } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/"
    ? pathname === "/"
    : pathname === href || pathname.startsWith(`${href}/`);

const multilang = config.locales.length > 1;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href={localeHref(locale, "/")}>{config.title}</a>
    <nav class="site-nav" aria-label="Primary">
      {
        config.nav.map((link) => {
          const href = localeHref(locale, link.href);
          return (
            <a
              href={href}
              aria-current={isActive(href) ? "page" : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
      {config.search && <Search />}
      {multilang && <LanguageSwitcher locale={locale} alternates={alternates} />}
      <ThemeToggle />
    </nav>
  </div>
</header>
