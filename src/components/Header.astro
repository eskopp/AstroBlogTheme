---
import config from "virtual:astro-blog-theme/config";
import ThemeToggle from "./ThemeToggle.astro";
import Search from "./Search.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { defaultLocale, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
  alternates?: { locale: Locale; href: string }[];
}
const { locale = defaultLocale, alternates = [] } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/"
    ? pathname === "/"
    : pathname === href || pathname.startsWith(`${href}/`);

const showSwitcher = config.locales.length > 1;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/">{config.title}</a>
    <nav class="site-nav" aria-label="Primary">
      {
        config.nav.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      {config.search && <Search />}
      {showSwitcher && <LanguageSwitcher locale={locale} alternates={alternates} />}
      <ThemeToggle />
    </nav>
  </div>
</header>
