---
import config from "virtual:astro-blog-theme/config";
import { defaultLocale, localeHref, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;
const year = new Date().getFullYear();

const resolve = (href: string) =>
  href.startsWith("/") ? localeHref(locale, href) : href;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <span>© {year}{config.author ? ` ${config.author}` : ""}</span>
    <nav aria-label="Social">
      {
        config.social.map((link, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <a href={resolve(link.href)}>{link.label}</a>
          </>
        ))
      }
    </nav>
  </div>
</footer>
