---
import { defaultLocale, type Locale } from "../i18n";

interface Props {
  date: Date;
  locale?: Locale;
}
const { date, locale = defaultLocale } = Astro.props;
const label = date.toLocaleDateString(locale, {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<time datetime={date.toISOString()}>{label}</time>
