---
import config from "virtual:astro-blog-theme/config";

interface Props {
  date: Date;
}
const { date } = Astro.props;
const locale = config.locale.replace("_", "-");
const label = date.toLocaleDateString(locale, {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<time datetime={date.toISOString()}>{label}</time>
