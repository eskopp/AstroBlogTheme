---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";
---

<BaseLayout title="About" description={`About ${SITE.title}.`}>
  <article class="prose">
    <h1>About</h1>
    <p>
      This is the demo <strong>About</strong> page that ships with the theme.
      Replace it with your own bio, project background, or contact details.
    </p>
    <p>
      The theme is built with <a href="https://astro.build">Astro</a>, ships zero
      client JavaScript except a tiny theme toggle, and renders posts from a
      Markdown content collection in <code>src/content/blog/</code>.
    </p>
    <h2>Editing this theme</h2>
    <ul>
      <li>Global settings live in <code>src/consts.ts</code>.</li>
      <li>Colors and typography live in <code>src/styles/global.css</code>.</li>
      <li>Layouts and components live in <code>src/layouts/</code> and <code>src/components/</code>.</li>
    </ul>
  </article>
</BaseLayout>
