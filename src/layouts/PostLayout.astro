---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { tagSlug } from "../tags";

interface Props {
  post: CollectionEntry<"blog">;
  prev?: { id: string; data: { title: string } };
  next?: { id: string; data: { title: string } };
}

const { post, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, heroAlt, tags, ai } =
  post.data;
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage?.src}
  article
>
  <article class="post">
    <header class="post__header">
      <h1>{title}</h1>
      <p class="post__meta">
        <FormattedDate date={pubDate} />
        {
          updatedDate && (
            <span>
              {" · updated "}
              <FormattedDate date={updatedDate} />
            </span>
          )
        }
        {
          ai && (
            <span class="ai-flag" title="AI was used while writing this post">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 3l2 5 5 2-5 2-2 5-2-5-5-2 5-2z" />
              </svg>
              AI
            </span>
          )
        }
      </p>
      {
        tags.length > 0 && (
          <ul class="tag-list">
            {tags.map((tag) => (
              <li>
                <a href={`/tags/${tagSlug(tag)}/`}>#{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      heroImage && (
        <img
          class="post__hero"
          src={heroImage.src}
          width={heroImage.width}
          height={heroImage.height}
          alt={heroAlt}
        />
      )
    }

    <div class="prose">
      <slot />
    </div>

    {
      (prev || next) && (
        <nav class="post__nav" aria-label="Post navigation">
          {prev && (
            <a href={`/blog/${prev.id}/`} rel="prev">
              ← {prev.data.title}
            </a>
          )}
          {next && (
            <a class="is-next" href={`/blog/${next.id}/`} rel="next">
              {next.data.title} →
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>
