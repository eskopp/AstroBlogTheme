---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import config from "virtual:astro-blog-theme/config";
import Toc from "../components/Toc.astro";
import PostCard from "../components/PostCard.astro";
import { tagSlug } from "../tags";
import { getTranslations, getRelated, readingTimeMinutes } from "../posts";
import { postLocale, postSlug, t } from "../i18n";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<"blog">;
  prev?: CollectionEntry<"blog">;
  next?: CollectionEntry<"blog">;
  headings?: Heading[];
}

const { post, prev, next, headings = [] } = Astro.props;
const readMin = readingTimeMinutes(post);
const { title, description, pubDate, updatedDate, heroImage, heroAlt, tags, ai } =
  post.data;

const locale = postLocale(post.id);
const translations = await getTranslations(post);
const related = await getRelated(post);
const alternates = [
  { locale, href: `/blog/${postSlug(post)}/` },
  ...translations.map((tr) => ({
    locale: tr.locale,
    href: `/blog/${tr.slug}/`,
  })),
];
const articleMeta = {
  published: pubDate.toISOString(),
  modified: updatedDate?.toISOString(),
};
const showToc = (post.data.toc ?? config.toc) !== false;
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage?.src ?? `/og/${postSlug(post)}.svg`}
  article
  articleMeta={articleMeta}
  locale={locale}
  alternates={alternates}
  wide
>
  <div class:list={["post-layout", { "has-toc": showToc }]}>
  <article class="post">
    <header class="post__header">
      <h1>{title}</h1>
      <p class="post__meta">
        <FormattedDate date={pubDate} locale={locale} />
        <span>{` · ${t("readingTime", locale, { min: readMin })}`}</span>
        {
          updatedDate && (
            <span>
              {` · ${t("updated", locale)} `}
              <FormattedDate date={updatedDate} locale={locale} />
            </span>
          )
        }
        {
          ai && (
            <span class="ai-flag" title={t("aiFlag", locale)}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 3l2 5 5 2-5 2-2 5-2-5-5-2 5-2z" />
              </svg>
              AI
            </span>
          )
        }
      </p>
      {
        tags.length > 0 && (
          <ul class="tag-list">
            {tags.map((tag) => (
              <li>
                <a href={`/tags/${tagSlug(tag)}/`}>#{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      heroImage && (
        <img
          class="post__hero"
          src={heroImage.src}
          width={heroImage.width}
          height={heroImage.height}
          alt={heroAlt}
        />
      )
    }

    {showToc && <Toc headings={headings} locale={locale} variant="inline" />}

    <div class="prose">
      <slot />
    </div>

    {
      (prev || next) && (
        <nav class="post__nav" aria-label={t("postNav", locale)}>
          {prev && (
            <a href={`/blog/${postSlug(prev)}/`} rel="prev">
              ← {prev.data.title}
            </a>
          )}
          {next && (
            <a class="is-next" href={`/blog/${postSlug(next)}/`} rel="next">
              {next.data.title} →
            </a>
          )}
        </nav>
      )
    }

    {
      related.length > 0 && (
        <section class="related">
          <h2 class="section-title">{t("relatedPosts", locale)}</h2>
          <ul class="post-list">
            {related.map((p) => (
              <li>
                <PostCard post={p} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
  {showToc && <Toc headings={headings} locale={locale} variant="aside" />}
  </div>
</BaseLayout>
