---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { defaultLocale, t, type Locale } from "../i18n";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  wide?: boolean;
  locale?: Locale;
  /** `{ locale, href }` for this page in other languages. */
  alternates?: { locale: Locale; href: string }[];
}

const {
  title,
  description,
  image,
  article = false,
  wide = false,
  locale = defaultLocale,
  alternates = [],
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      article={article}
      locale={locale}
      alternates={alternates}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{t("skipToContent", locale)}</a>
    <Header locale={locale} alternates={alternates} />
    <main id="main" class:list={["container", { wide }]}>
      <slot />
    </main>
    <Footer locale={locale} />
    <script is:inline>
      // Open links to other origins (external domains and subdomains) in a new tab.
      for (const a of document.querySelectorAll("a[href]")) {
        try {
          const u = new URL(a.getAttribute("href"), location.href);
          if (
            (u.protocol === "http:" || u.protocol === "https:") &&
            u.origin !== location.origin
          ) {
            a.target = "_blank";
            a.rel = (a.rel ? a.rel + " " : "") + "noopener noreferrer";
          }
        } catch (e) {
          /* ignore unparseable hrefs */
        }
      }
    </script>
  </body>
</html>
